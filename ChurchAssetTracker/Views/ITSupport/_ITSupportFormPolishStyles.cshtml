<style>
.it-form-hero {
    background: linear-gradient(135deg, #174c2f, #0f172a);
    color: #fff;
    border-radius: 24px;
    padding: 26px;
    margin-bottom: 22px;
    box-shadow: 0 18px 40px rgba(15,23,42,.18);
}

.it-form-hero h2 {
    margin: 6px 0;
    color: #fff !important;
    font-size: 2rem;
}

.it-form-hero p {
    margin: 0;
    color: #d1fae5 !important;
}

.it-form-shell {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(320px, .65fr);
    gap: 22px;
    align-items: start;
}

.it-form-card {
    background: #fff;
    border: 1px solid #dbe3ea;
    border-radius: 22px;
    padding: 22px;
    box-shadow: 0 10px 28px rgba(15,23,42,.06);
}

.it-form-card h3 {
    margin: 0 0 6px;
}

.it-form-card > p {
    margin-top: 0;
    color: #64748b;
}

.it-form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
}

.it-form-grid.three {
    grid-template-columns: repeat(3, minmax(0, 1fr));
}

.it-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.it-field.full {
    grid-column: 1 / -1;
}

.it-field label {
    font-weight: 800;
    color: #0f172a;
}

.it-field small {
    color: #64748b;
}

.it-field input,
.it-field select,
.it-field textarea {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid #cbd5e1;
    border-radius: 14px;
    padding: 12px 13px;
    background: #fff;
    color: #0f172a;
    font-size: .98rem;
}

.it-field textarea {
    min-height: 130px;
    resize: vertical;
}

.it-field input:focus,
.it-field select:focus,
.it-field textarea:focus {
    outline: none;
    border-color: #15803d;
    box-shadow: 0 0 0 3px rgba(21,128,61,.14);
}

.it-help-panel {
    background: #f8fafc;
    border: 1px solid #dbe3ea;
    border-radius: 18px;
    padding: 16px;
    margin-bottom: 16px;
}

.it-help-panel strong,
.it-help-panel span {
    display: block;
}

.it-help-panel span {
    color: #64748b;
    margin-top: 4px;
    line-height: 1.45;
}

.it-side-panel {
    display: grid;
    gap: 16px;
}

.it-side-box {
    background: #fff;
    border: 1px solid #dbe3ea;
    border-radius: 22px;
    padding: 18px;
    box-shadow: 0 10px 28px rgba(15,23,42,.06);
}

.it-side-box h3 {
    margin: 0 0 8px;
}

.it-side-box ul {
    margin: 10px 0 0;
    padding-left: 20px;
    color: #475569;
}

.it-side-box li {
    margin-bottom: 8px;
}

.it-form-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 20px;
    padding-top: 18px;
    border-top: 1px solid #e2e8f0;
}

.it-form-actions .btn,
.it-form-actions button {
    min-width: 140px;
}

.it-validation {
    background: #fee2e2;
    color: #991b1b;
    border: 1px solid #fecaca;
    border-radius: 16px;
    padding: 14px;
    margin-bottom: 18px;
}

.it-priority-guide {
    display: grid;
    gap: 8px;
}

.it-guide-pill {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 10px 12px;
    background: #f8fafc;
}

.it-guide-pill strong {
    color: #0f172a;
}

.it-guide-pill span {
    color: #64748b;
    font-size: .9rem;
}

html.dark-mode .it-form-card,
html.dark-mode .it-side-box {
    background: #111827 !important;
    color: #e5e7eb !important;
    border-color: #334155 !important;
    box-shadow: 0 12px 28px rgba(0,0,0,.32) !important;
}

html.dark-mode .it-form-card > p,
html.dark-mode .it-help-panel span,
html.dark-mode .it-side-box ul,
html.dark-mode .it-guide-pill span,
html.dark-mode .it-field small {
    color: #94a3b8 !important;
}

html.dark-mode .it-field label,
html.dark-mode .it-guide-pill strong {
    color: #f8fafc !important;
}

html.dark-mode .it-help-panel,
html.dark-mode .it-guide-pill {
    background: #020617 !important;
    border-color: #334155 !important;
}

html.dark-mode .it-field input,
html.dark-mode .it-field select,
html.dark-mode .it-field textarea {
    background: #020617 !important;
    color: #e5e7eb !important;
    border-color: #475569 !important;
}

html.dark-mode .it-form-actions {
    border-top-color: #334155 !important;
}

@@media(max-width: 1000px) {
    .it-form-shell {
        grid-template-columns: 1fr;
    }

    .it-form-grid,
    .it-form-grid.three {
        grid-template-columns: 1fr;
    }
}
</style>