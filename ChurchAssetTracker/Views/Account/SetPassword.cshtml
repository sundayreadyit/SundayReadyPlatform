@{ Layout = null; var token = Convert.ToString(ViewBag.Token ?? ""); var displayName = Convert.ToString(ViewBag.DisplayName ?? ""); var username = Convert.ToString(ViewBag.Username ?? ""); }
<!DOCTYPE html><html><head><meta charset="utf-8" /><title>Set Password - CWC Operations Portal</title><style>body{margin:0;min-height:100vh;font-family:Arial,Helvetica,sans-serif;background:#f1f5f9;display:flex;align-items:center;justify-content:center}.card{width:420px;background:white;border:1px solid #dbe3ea;border-radius:22px;padding:32px;box-shadow:0 18px 50px rgba(15,23,42,.15)}h1{margin:0;color:#174c2f}p{color:#475569;line-height:1.45}label{display:block;margin-top:14px;font-weight:700}input{width:100%;box-sizing:border-box;padding:12px;border:1px solid #cbd5e1;border-radius:10px;margin-top:6px}button,a.btn{display:block;text-align:center;margin-top:20px;border:0;border-radius:10px;padding:12px;background:#174c2f;color:white;font-weight:800;text-decoration:none}.validation-summary-errors{color:#b91c1c;background:#fef2f2;border:1px solid #fecaca;border-radius:12px;padding:12px;margin-top:16px}</style></head><body><div class="card"><h1>Set Your Password</h1><p>Hello @displayName, create your password for the CWC Operations Portal.</p><p>Username: <strong>@username</strong></p><form method="post">@Html.AntiForgeryToken()<input type="hidden" name="token" value="@token" /><div asp-validation-summary="All"></div><label>Password</label><input type="password" name="password" autocomplete="new-password" required /><label>Confirm Password</label><input type="password" name="confirmPassword" autocomplete="new-password" required /><button type="submit">Set Password</button></form></div></body></html>