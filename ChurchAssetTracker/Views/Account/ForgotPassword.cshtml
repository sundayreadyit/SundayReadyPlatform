@{
    Layout = null;
    ViewData["Title"] = "Forgot Password";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Forgot Password - CWC Operations Portal</title>

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <style>
        body {
            margin: 0;
            min-height: 100vh;
            font-family: Arial, Helvetica, sans-serif;
            background:
                radial-gradient(circle at top left, rgba(23,76,47,.18), transparent 34%),
                radial-gradient(circle at bottom right, rgba(34,197,94,.12), transparent 28%),
                #f1f5f9;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #0f172a;
        }

        .reset-card {
            width: min(100%, 480px);
            background: #fff;
            border: 1px solid #dbe3ea;
            border-radius: 26px;
            padding: 30px;
            box-shadow: 0 20px 50px rgba(15,23,42,.14);
            margin: 24px;
        }

        .reset-card h1 {
            margin: 0 0 10px;
            color: #174c2f;
            font-size: 1.9rem;
        }

        .reset-card p {
            color: #64748b;
            line-height: 1.5;
        }

        .reset-form {
            margin-top: 22px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 7px;
            margin-bottom: 16px;
        }

        .form-group label {
            font-weight: 800;
            color: #0f172a;
        }

        .form-group input {
            width: 100%;
            box-sizing: border-box;
            border: 1px solid #cbd5e1;
            border-radius: 14px;
            padding: 13px 14px;
            font-size: 1rem;
        }

        .reset-button {
            width: 100%;
            border: 0;
            border-radius: 14px;
            padding: 13px 16px;
            font-weight: 900;
            background: #174c2f;
            color: #fff;
            cursor: pointer;
            font-size: 1rem;
        }

        .back-link {
            display: block;
            margin-top: 16px;
            text-align: center;
            color: #174c2f;
            font-weight: 800;
            text-decoration: none;
        }

        .alert {
            border-radius: 14px;
            padding: 12px 14px;
            margin: 16px 0;
        }

        .alert.success {
            background: #dcfce7;
            border: 1px solid #bbf7d0;
            color: #166534;
        }

        .alert.danger {
            background: #fee2e2;
            border: 1px solid #fecaca;
            color: #991b1b;
        }
    </style>
</head>

<body>
    <section class="reset-card">
        <h1>Reset Password</h1>

        <p>
            Enter your portal username or email address. If an active account exists,
            a password reset link will be sent.
        </p>

        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert success">@ViewBag.SuccessMessage</div>
        }

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert danger">@ViewBag.ErrorMessage</div>
        }

        <form asp-controller="ForgotPassword" asp-action="Index" method="post" class="reset-form">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label for="usernameOrEmail">Username or Email</label>
                <input id="usernameOrEmail"
                       name="usernameOrEmail"
                       type="text"
                       autocomplete="username"
                       required />
            </div>

            <button type="submit" class="reset-button">
                Send Reset Link
            </button>
        </form>

        <a class="back-link" asp-controller="Account" asp-action="Login">
            Back to Sign In
        </a>
    </section>
</body>
</html>
