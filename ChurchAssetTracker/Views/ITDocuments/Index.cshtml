@model ChurchAssetTracker.Models.ITDocumentLibraryViewModel
@{
    ViewData["Title"] = "Documentation Library";
}

<div class="doc-hero">
    <div>
        <span class="eyebrow">Shared Resource</span>
        <h2>Documentation Library</h2>
        <p>Search and download church, school, enrollment, policy, form, and IT documentation from the shared documentation folder.</p>
    </div>
    <div class="doc-root-status @(Model.RootExists ? "ok" : "warn")">
        <strong>@(Model.RootExists ? "Share Online" : "Share Not Available")</strong>
        <span>@Model.RootPath</span>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert danger"><strong>Documentation Library Error:</strong> @Model.ErrorMessage</div>
}

<section class="doc-card">
    <form asp-action="Index" method="get" class="doc-filter">
        <div class="doc-field grow">
            <label>Search Documents</label>
            <input type="text" name="search" value="@Model.Search" placeholder="Document number, title, description, filename, category..." />
        </div>
        <div class="doc-field">
            <label>Category</label>
            <select name="category">
                @foreach (var category in Model.Categories)
                {
                    <option value="@category" selected="@(Model.Category == category)">@category</option>
                }
            </select>
        </div>
        <div class="doc-actions">
            <button class="btn primary" type="submit">Search</button>
            <a class="btn" asp-action="Index">Clear</a>
        </div>
    </form>

    <div class="doc-summary">
        <span><strong>@Model.Documents.Count</strong> document@(Model.Documents.Count == 1 ? "" : "s") found</span>
        <span>Source: <code>@Model.RootPath</code></span>
    </div>

    @if (Model.Documents == null || !Model.Documents.Any())
    {
        <div class="doc-empty">
            <strong>No documents found</strong>
            <span>Copy supported documents into <code>@Model.RootPath</code>, then refresh this page.</span>
            <small>Supported types include PDF, Word, Excel, PowerPoint, TXT, PNG, and JPG.</small>
        </div>
    }
    else
    {
        <div class="doc-grid">
            @foreach (var doc in Model.Documents)
            {
                <article class="doc-row">
                    <div class="doc-icon">@GetIcon(doc.OriginalFileName)</div>
                    <div class="doc-info">
                        <div class="doc-title-line">
                            @if (!string.IsNullOrWhiteSpace(doc.DocumentNumber))
                            {
                                <span class="doc-number">@doc.DocumentNumber</span>
                            }
                            <strong>@doc.Title</strong>
                        </div>
                        <div class="doc-meta">@doc.Category • @doc.OriginalFileName • @doc.FileSizeDisplay</div>
                        @if (!string.IsNullOrWhiteSpace(doc.Description))
                        {
                            <p>@doc.Description</p>
                        }
                        <small>Modified @(doc.ModifiedDate.HasValue ? doc.ModifiedDate.Value.ToString("g") : doc.UploadedDate.ToString("g"))</small>
                    </div>
                    <div class="doc-row-actions">
                        <a class="btn primary" asp-action="Download" asp-route-file="@doc.DownloadToken">Download</a>
                    </div>
                </article>
            }
        </div>
    }
</section>

@functions {
    private string GetIcon(string fileName)
    {
        var ext = System.IO.Path.GetExtension(fileName ?? "").ToLowerInvariant();
        return ext switch
        {
            ".pdf" => "📕",
            ".doc" or ".docx" => "📘",
            ".xls" or ".xlsx" => "📗",
            ".ppt" or ".pptx" => "📙",
            ".png" or ".jpg" or ".jpeg" => "🖼️",
            ".txt" => "📄",
            _ => "📁"
        };
    }
}

<style>
    .doc-hero{display:flex;justify-content:space-between;align-items:stretch;gap:18px;background:linear-gradient(135deg,#0f3f2a,#0f766e);color:#fff;border-radius:22px;padding:24px;margin-bottom:22px;box-shadow:0 18px 38px rgba(15,23,42,.14)}
    .doc-hero h2{margin:.25rem 0;font-size:2rem;color:#fff}.doc-hero p{margin:0;opacity:.9;max-width:760px}.eyebrow{text-transform:uppercase;letter-spacing:.13em;font-size:.75rem;font-weight:800;opacity:.85}
    .doc-root-status{min-width:240px;border:1px solid rgba(255,255,255,.25);border-radius:18px;padding:14px;background:rgba(255,255,255,.12);display:flex;flex-direction:column;justify-content:center;gap:5px}.doc-root-status strong{font-size:1rem}.doc-root-status span{font-size:.85rem;opacity:.9;word-break:break-all}.doc-root-status.warn{background:rgba(245,158,11,.22)}
    .doc-card{background:#fff;border:1px solid #dbe3ea;border-radius:20px;padding:20px;box-shadow:0 10px 26px rgba(15,23,42,.08)}
    .doc-filter{display:flex;gap:14px;align-items:end;flex-wrap:wrap;margin-bottom:14px}.doc-field{display:flex;flex-direction:column;gap:6px;min-width:220px}.doc-field.grow{flex:1;min-width:300px}.doc-field label{font-weight:800;color:#0f172a}.doc-field input,.doc-field select{border:1px solid #cbd5e1;border-radius:12px;padding:10px 12px;background:#fff;color:#0f172a}.doc-actions{display:flex;gap:8px;align-items:center}.doc-summary{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;color:#64748b;border-top:1px solid #e2e8f0;padding-top:14px;margin-bottom:14px}.doc-summary code,.doc-empty code{background:#f1f5f9;border-radius:6px;padding:2px 5px;color:#0f172a}
    .doc-empty{border:1px dashed #cbd5e1;border-radius:18px;padding:26px;text-align:center;color:#64748b}.doc-empty strong,.doc-empty span,.doc-empty small{display:block;margin:5px 0}
    .doc-grid{display:flex;flex-direction:column;gap:12px}.doc-row{display:flex;gap:14px;align-items:center;border:1px solid #e2e8f0;border-radius:16px;padding:14px;background:#f8fafc}.doc-icon{font-size:2rem;width:44px;text-align:center}.doc-info{flex:1}.doc-title-line{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.doc-number{background:#dbeafe;color:#1d4ed8;font-weight:900;border-radius:999px;padding:4px 9px;font-size:.78rem}.doc-info strong{font-size:1.05rem;color:#0f172a}.doc-meta,.doc-info small{color:#64748b}.doc-info p{margin:.35rem 0;color:#475569}.doc-row-actions{display:flex;gap:8px;align-items:center}
    .btn{display:inline-flex;align-items:center;justify-content:center;border:1px solid #cbd5e1;background:#fff;color:#0f172a;border-radius:12px;padding:9px 13px;text-decoration:none;font-weight:800;cursor:pointer}.btn.primary{background:#174c2f;color:#fff;border-color:#174c2f}.alert.danger{border:1px solid #fecaca;background:#fef2f2;color:#991b1b;padding:12px 14px;border-radius:14px;margin-bottom:16px}
    html.dark-mode .doc-card,html.dark-mode .doc-row{background:#111827!important;color:#e5e7eb!important;border-color:#334155!important}html.dark-mode .doc-info strong,html.dark-mode .doc-field label{color:#f8fafc!important}html.dark-mode .doc-meta,html.dark-mode .doc-info p,html.dark-mode .doc-info small,html.dark-mode .doc-summary{color:#94a3b8!important}html.dark-mode .doc-field input,html.dark-mode .doc-field select{background:#020617!important;color:#e5e7eb!important;border-color:#475569!important}html.dark-mode .doc-summary code,html.dark-mode .doc-empty code{background:#020617!important;color:#e5e7eb!important}
    @@media(max-width:760px){.doc-hero{flex-direction:column}.doc-row{align-items:flex-start}.doc-row-actions{width:100%}.doc-row{flex-wrap:wrap}.doc-row-actions .btn{width:100%}}
</style>
