@model List<ChurchAssetTracker.Models.WorshipSetSummary>
@{ ViewData["Title"] = "Worship Set History"; }
<div class="history-page">
 <div class="history-head"><div><span>Worship Planning</span><h1>Past Worship Sets</h1><p>Review previous services, duplicate a set, or see when songs were last used.</p></div><a asp-action="Index">← Worship Home</a></div>
 @if(!Model.Any()){<div class="empty">No past worship sets yet.</div>}
 else{<div class="history-list">@foreach(var set in Model){<a asp-action="EditSet" asp-route-id="@set.Id" class="history-row"><div><strong>@set.ServiceDate.ToString("MMM d, yyyy")</strong><span>@set.ServiceDate.ToString("dddd")</span></div><div class="main"><h3>@set.Title</h3><p>@set.SongCount song@(set.SongCount==1?"":"s") • @set.Status</p></div><span class="open">Open →</span></a>}</div>}
</div>
<style>
.history-page{max-width:1000px;margin:0 auto}.history-head{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:18px}.history-head span{color:var(--portal-accent,#16a34a);font-weight:800;text-transform:uppercase;letter-spacing:.1em;font-size:.75rem}.history-head h1{margin:3px 0}.history-head p{margin:0;color:#64748b}.history-head a,.open{color:var(--portal-primary,#174c2f);font-weight:800;text-decoration:none}.history-list{display:grid;gap:10px}.history-row{display:grid;grid-template-columns:150px 1fr auto;align-items:center;gap:18px;background:#fff;border:1px solid #dbe3ea;border-radius:14px;padding:16px;text-decoration:none;color:#0f172a}.history-row div:first-child{display:flex;flex-direction:column}.history-row div:first-child span{color:#64748b;text-transform:none;letter-spacing:0}.history-row h3{margin:0 0 4px}.history-row p{margin:0;color:#64748b}.empty{background:#fff;border:1px dashed #cbd5e1;border-radius:14px;padding:20px}html.dark-mode .history-row,html.dark-mode .empty{background:#111827;color:#e5e7eb;border-color:#334155}html.dark-mode .history-row p,html.dark-mode .history-row div:first-child span,html.dark-mode .history-head p{color:#94a3b8}html.dark-mode .history-head a,html.dark-mode .open{color:#4ade80}@@media(max-width:700px){.history-row{grid-template-columns:1fr}.history-head{align-items:flex-start;flex-direction:column}}
</style>
