@model ChurchAssetTracker.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="page-header">
    <div>
        <h2>Change Password</h2>
        <p>Update your CWC Operations Portal password.</p>
    </div>
    <a class="btn" asp-controller="Profile" asp-action="Index">Back to Profile</a>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert danger">
        <strong>Please fix the following:</strong>
        <div asp-validation-summary="All"></div>
    </div>
}

<form asp-action="ChangePassword" method="post" class="form-card">
    @Html.AntiForgeryToken()

    <label>Current Password</label>
    <input asp-for="CurrentPassword" type="password" autocomplete="current-password" />

    <label>New Password</label>
    <input asp-for="NewPassword" type="password" autocomplete="new-password" />

    <label>Confirm New Password</label>
    <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />

    <div class="form-actions">
        <button class="btn primary" type="submit">Change Password</button>
        <a class="btn" asp-controller="Profile" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
