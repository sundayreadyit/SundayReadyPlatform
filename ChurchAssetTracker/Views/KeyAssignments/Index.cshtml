@model IEnumerable<ChurchAssetTracker.Models.KeyAssignmentRow>
@{
    ViewData["Title"] = "Key Assignments";

    var groupedAssignments = Model
        .GroupBy(k => new { k.PersonId, k.KeyHolder })
        .OrderBy(g => g.Key.KeyHolder);
}

<div class="key-assignment-page-wrap">
<div class="page-header">
    <div>
        <h1>Key Assignments</h1>
        <p>Track who has church keys, when they were issued, and when they are returned.</p>
    </div>

    <div class="key-assignment-actions">
        <a class="btn-primary" asp-controller="KeyAssignments" asp-action="Create">Assign Key</a>
        <a class="btn-secondary" asp-controller="KeyAssignmentsBulk" asp-action="BulkCreate">Assign Multiple Keys</a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-success">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="key-assignment-summary-grid">
    <div class="summary-card"><span>Key Holders</span><strong>@groupedAssignments.Count()</strong></div>
    <div class="summary-card"><span>Active Keys</span><strong>@Model.Count(k => k.ReturnedDate == null)</strong></div>
    <div class="summary-card"><span>Returned Keys</span><strong>@Model.Count(k => k.ReturnedDate != null)</strong></div>
</div>

<div class="table-card key-assignment-page">
    <table class="data-table key-assignment-table">
        <thead>
            <tr>
                <th>Key Holder</th>
                <th>Assigned Keys</th>
                <th>Returned Keys</th>
                <th>Last Issued</th>
                <th>Status</th>
                <th class="actions-col">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var group in groupedAssignments)
        {
            var activeKeys = group.Where(k => k.ReturnedDate == null).ToList();
            var returnedKeys = group.Where(k => k.ReturnedDate != null).ToList();
            var lastIssued = group.Any() ? group.Max(k => k.IssuedDate) : (DateTime?)null;
            var hasActiveKeys = activeKeys.Any();

            <tr>
                <td>
                    <a class="key-holder-link" asp-action="Details" asp-route-personId="@group.Key.PersonId">
                        @group.Key.KeyHolder
                    </a>
                    <div class="subtle-text">Click name to view assigned keys</div>
                </td>
                <td><span class="count-pill active-count">@activeKeys.Count</span></td>
                <td><span class="count-pill returned-count">@returnedKeys.Count</span></td>
                <td>@(lastIssued.HasValue ? lastIssued.Value.ToShortDateString() : "None")</td>
                <td>
                    @if (hasActiveKeys)
                    {
                        <span class="badge active">Active</span>
                    }
                    else
                    {
                        <span class="badge inactive">Returned</span>
                    }
                </td>
                <td class="actions compact-actions">
                    <a class="btn-secondary" asp-action="Details" asp-route-personId="@group.Key.PersonId">View</a>
                    <a class="btn-primary" asp-action="EditPerson" asp-route-personId="@group.Key.PersonId">Edit</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<style>
    .key-assignment-page-wrap .page-header{align-items:flex-start}
    .key-assignment-actions{display:flex;gap:10px;flex-wrap:wrap;align-items:center;justify-content:flex-end}
    .key-assignment-actions a{display:inline-flex;align-items:center;justify-content:center;text-decoration:none!important;white-space:nowrap}
    .key-assignment-summary-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-bottom:16px}
    .summary-card{background:#ffffff;border:1px solid #dbe3ea;border-radius:16px;padding:16px;box-shadow:0 10px 24px rgba(15,23,42,.06)}
    .summary-card span{display:block;color:#475569;font-weight:800;font-size:.86rem}
    .summary-card strong{display:block;font-size:1.8rem;margin-top:4px;color:#0f172a}
    .key-holder-link{font-weight:800;color:#166534;text-decoration:none}
    .key-holder-link:hover{text-decoration:underline}
    .subtle-text{font-size:.82rem;color:#64748b;margin-top:3px}
    .count-pill{display:inline-flex;align-items:center;justify-content:center;min-width:44px;border-radius:999px;padding:6px 12px;font-weight:800}
    .active-count{background:#dcfce7;color:#14532d;border:1px solid #bbf7d0}
    .returned-count{background:#f1f5f9;color:#334155;border:1px solid #cbd5e1}
    .compact-actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}

    html.dark-mode .summary-card{background:#111827!important;border-color:#334155!important;box-shadow:0 16px 32px rgba(0,0,0,.24)}
    html.dark-mode .summary-card strong{color:#f8fafc!important}
    html.dark-mode .summary-card span,
    html.dark-mode .subtle-text{color:#cbd5e1!important}
    html.dark-mode .key-holder-link{color:#93c5fd!important}
    html.dark-mode .returned-count{background:#1e293b!important;color:#e2e8f0!important;border-color:#475569!important}
    html.dark-mode .table-card.key-assignment-page{background:#111827!important;border-color:#334155!important}
    html.dark-mode .key-assignment-table{background:#111827!important;color:#f8fafc!important}
    html.dark-mode .key-assignment-table th{background:#1f2937!important;color:#f8fafc!important;border-color:#334155!important}
    html.dark-mode .key-assignment-table td{background:#111827!important;color:#f8fafc!important;border-color:#334155!important}
    html.dark-mode .key-assignment-table tr:hover td{background:#1e293b!important}
    html.dark-mode .key-assignment-actions .btn-secondary{background:#f8fafc!important;color:#2563eb!important;border:1px solid #cbd5e1!important;text-decoration:none!important}
    html.dark-mode .key-assignment-actions .btn-primary{background:#166534!important;color:#fff!important;border:1px solid #15803d!important;text-decoration:none!important}
    @@media(max-width:800px){.key-assignment-summary-grid{grid-template-columns:1fr}.key-assignment-table th:nth-child(3),.key-assignment-table td:nth-child(3){display:none}.key-assignment-actions{justify-content:flex-start}}
</style>
</div>
