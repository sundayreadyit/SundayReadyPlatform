@using ChurchAssetTracker.Models
@inject ChurchAssetTracker.Services.SystemSettingsService SystemSettings

@{
    ViewData["Title"] = "About";
    var branding = await SystemSettings.GetBrandingAsync();
    var modules = await SystemSettings.GetModulesAsync();
}

<style>
    .about-page {
        color: var(--bs-body-color, #e5e7eb);
    }

    .about-hero {
        background: linear-gradient(135deg, var(--portal-secondary), var(--portal-primary));
        border-radius: 16px;
        padding: 28px;
        margin-bottom: 22px;
        color: #ffffff;
        box-shadow: 0 10px 30px rgba(0,0,0,.25);
    }

    .about-card {
        background: #111827;
        border: 1px solid #334155;
        border-radius: 16px;
        color: #e5e7eb;
        box-shadow: 0 10px 30px rgba(0,0,0,.25);
        margin-bottom: 18px;
    }

    .about-card .card-header {
        background: #0f172a;
        border-bottom: 1px solid #334155;
        color: #f8fafc;
        font-weight: 700;
        border-top-left-radius: 16px;
        border-top-right-radius: 16px;
    }

    .about-table {
        color: #e5e7eb;
        margin-bottom: 0;
    }

    .about-table td {
        border-color: #334155;
        padding: 12px 14px;
        vertical-align: middle;
    }

    .about-table td:first-child {
        color: #93c5fd;
        width: 220px;
        font-weight: 600;
    }

    .module-list {
        columns: 2;
        margin-bottom: 0;
    }

    .module-list li {
        margin-bottom: 6px;
    }

    .release-note {
        border-left: 4px solid #16a34a;
        padding-left: 16px;
    }

    .release-note h5 {
        color: #f8fafc;
    }

    .release-note .text-muted,
    .about-card .text-muted {
        color: #cbd5e1 !important;
    }

    @@media (max-width: 768px) {
        .module-list {
            columns: 1;
        }

        .about-table td:first-child {
            width: 145px;
        }
    }
</style>

<div class="about-page container-fluid mt-4">
    <div class="about-hero">
        <h1 class="mb-2">@branding.PortalName</h1>
        <p class="mb-1">@branding.PortalSubtitle</p>
        <p class="mb-0" style="opacity:.78">Powered by Sunday Ready Platform • Developed by Sunday Ready IT</p>
    </div>

    <div class="row">
        <div class="col-lg-6">
            <div class="card about-card">
                <div class="card-header">Application Information</div>
                <div class="card-body p-0">
                    <table class="table about-table">
                        <tbody>
                            <tr>
                                <td>Application</td>
                                <td>@branding.PortalName</td>
                            </tr>
                            <tr>
                                <td>Version</td>
                                <td>v@(PortalVersion.Version)</td>
                            </tr>
                            <tr>
                                <td>Release Name</td>
                                <td>@PortalVersion.ReleaseName</td>
                            </tr>
                            <tr>
                                <td>Build Date</td>
                                <td>@PortalVersion.BuildDate</td>
                            </tr>
                            <tr>
                                <td>Developed By</td>
                                <td><strong>Sunday Ready IT</strong></td>
                            </tr>
                            <tr>
                                <td>Licensed To</td>
                                <td>@branding.OrganizationName</td>
                            </tr>
                            <tr>
                                <td>Copyright</td>
                                <td>© 2026 Sunday Ready IT. All Rights Reserved.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card about-card">
                <div class="card-header">Portal Modules</div>
                <div class="card-body">
                    <ul class="module-list">
                        @foreach (var module in modules.Where(m => m.IsEnabled))
                        {
                            <li>@module.DisplayName</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="card about-card">
        <div class="card-header">Release Notes</div>
        <div class="card-body">
            <div class="release-note">
                <h5>v@(PortalVersion.Version) - @PortalVersion.ReleaseName</h5>
                <p class="text-muted mb-2">Build Date: @PortalVersion.BuildDate</p>
                <ul class="mb-0">
                    <li>Added Administration → System Settings with runtime configuration stored in the portal database.</li>
                    <li>Added a deployment Setup Wizard/checklist for organization, email, storage, modules and dashboard configuration.</li>
                    <li>Added organization customization including organization name, portal name, subtitle and organization logo upload.</li>
                    <li>Added Sunday Ready IT product branding, licensing footer and application ownership information.</li>
                    <li>Moved SMTP configuration into the Administration GUI and added encrypted SMTP password storage plus Send Test Email.</li>
                    <li>Moved Documentation Library and Worship Library paths into runtime Administration settings with path testing.</li>
                    <li>Added Module Manager so organizations can enable or disable optional portal modules without deleting data.</li>
                    <li>Added Dashboard Builder with role-profile widget selection and drag/drop ordering.</li>
                    <li>Added collapsible navigation groups with per-browser remembered state for a cleaner sidebar.</li>
                    <li>Added initial Worship Song Library for searching, viewing, printing and downloading licensed song files.</li>
                    <li>Expanded dark-mode support to the Administration and Worship interfaces.</li>
                </ul>
            </div>
        </div>
    </div>
</div>
