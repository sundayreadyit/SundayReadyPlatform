@using ChurchAssetTracker.Models
@inject ChurchAssetTracker.Services.SystemSettingsService SystemSettings

@{
    ViewData["Title"] = "About";
    var branding = await SystemSettings.GetBrandingAsync();
    var modules = await SystemSettings.GetModulesAsync();
}

<style>
    .about-page {
        color: var(--bs-body-color, #e5e7eb);
    }

    .about-hero {
        background: linear-gradient(135deg, var(--portal-secondary), var(--portal-primary));
        border-radius: 16px;
        padding: 28px;
        margin-bottom: 22px;
        color: #ffffff;
        box-shadow: 0 10px 30px rgba(0,0,0,.25);
    }

    .about-card {
        background: #111827;
        border: 1px solid #334155;
        border-radius: 16px;
        color: #e5e7eb;
        box-shadow: 0 10px 30px rgba(0,0,0,.25);
        margin-bottom: 18px;
    }

    .about-card .card-header {
        background: #0f172a;
        border-bottom: 1px solid #334155;
        color: #f8fafc;
        font-weight: 700;
        border-top-left-radius: 16px;
        border-top-right-radius: 16px;
    }

    .about-table {
        color: #e5e7eb;
        margin-bottom: 0;
    }

    .about-table td {
        border-color: #334155;
        padding: 12px 14px;
        vertical-align: middle;
    }

    .about-table td:first-child {
        color: #93c5fd;
        width: 220px;
        font-weight: 600;
    }

    .module-list {
        columns: 2;
        margin-bottom: 0;
    }

    .module-list li {
        margin-bottom: 6px;
    }

    .release-note {
        border-left: 4px solid #16a34a;
        padding-left: 16px;
    }

    .release-note h5 {
        color: #f8fafc;
    }

    .release-note .text-muted,
    .about-card .text-muted {
        color: #cbd5e1 !important;
    }

    @@media (max-width: 768px) {
        .module-list {
            columns: 1;
        }

        .about-table td:first-child {
            width: 145px;
        }
    }
</style>

<div class="about-page container-fluid mt-4">
    <div class="about-hero">
        <h1 class="mb-2">@branding.PortalName</h1>
        <p class="mb-1">@branding.PortalSubtitle</p>
        <p class="mb-0" style="opacity:.78">Powered by Sunday Ready Platform • Developed by Sunday Ready IT</p>
    </div>

    <div class="row">
        <div class="col-lg-6">
            <div class="card about-card">
                <div class="card-header">Application Information</div>
                <div class="card-body p-0">
                    <table class="table about-table">
                        <tbody>
                            <tr>
                                <td>Application</td>
                                <td>@branding.PortalName</td>
                            </tr>
                            <tr>
                                <td>Version</td>
                                <td>v@(PortalVersion.Version)</td>
                            </tr>
                            <tr>
                                <td>Release Name</td>
                                <td>@PortalVersion.ReleaseName</td>
                            </tr>
                            <tr>
                                <td>Build Date</td>
                                <td>@PortalVersion.BuildDate</td>
                            </tr>
                            <tr>
                                <td>Developed By</td>
                                <td><strong>Sunday Ready IT</strong></td>
                            </tr>
                            <tr>
                                <td>Licensed To</td>
                                <td>@branding.OrganizationName</td>
                            </tr>
                            <tr>
                                <td>Copyright</td>
                                <td>© 2026 Sunday Ready IT. All Rights Reserved.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card about-card">
                <div class="card-header">Portal Modules</div>
                <div class="card-body">
                    <ul class="module-list">
                        @foreach (var module in modules.Where(m => m.IsEnabled))
                        {
                            <li>@module.DisplayName</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="card about-card">
        <div class="card-header">Release Notes</div>
        <div class="card-body">
            <div class="release-note">
                <h5>v@(PortalVersion.Version) - @PortalVersion.ReleaseName</h5>
                <p class="text-muted mb-2">Build Date: @PortalVersion.BuildDate</p>
                <ul class="mb-0">
                    <li>Added complete Worship Planning with Sunday service sets, upcoming services and worship history.</li>
                    <li>Added searchable CCLI song selection directly from the configured Worship Library share.</li>
                    <li>Added drag-and-drop song ordering with automatic save of the Sunday playlist order.</li>
                    <li>Added optional key, worship leader and transition/service notes for each song.</li>
                    <li>Added one-click combined PDF worship packets with an organization-branded cover, a dedicated song-order page for musicians/ProPresenter, and all selected PDFs in set order.</li>
                    <li>Added Print Set List for a clean running-order page, plus Songs Only for chart-only packets.</li>
                    <li>Added Duplicate Set for quickly copying a previous service and moving the copied date forward one week.</li>
                    <li>Added song usage history showing times used and last-used date in the Worship Library.</li>
                    <li>Added graceful validation for missing or unreadable PDFs so the portal identifies the song preventing packet generation.</li>
                    <li>Includes all v1.5.2 Administration validation fixes and borderless organization-logo improvements; v1.5.2 does not need to be deployed separately.</li>
                    <li>Added the WorshipLeader security role so Worship Planning is limited to Admin and authorized worship users.</li>
                    <li>Added the Worship Planning database schema and WorshipLeader role with automatic startup provisioning and an optional SQL migration script.</li>
                </ul>
            </div>
        </div>
    </div>
</div>
