@model PersonEditViewModel
@{
    ViewData["Title"] = "Add Person";
}

<div class="page-header">
    <div>
        <h2>Add Person</h2>
        <p>Add someone who may borrow church property, request reservations, or be issued keys.</p>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.ReturnUrl))
    {
        <div class="alert alert-info" style="margin-top:.75rem;">
            After saving this person, you will be returned to the form you were working on.
        </div>
    }
</div>

<partial name="_PersonForm" model="Model" />
