                    @if (canReservations) { <a class="nav-link" asp-controller="Reservations" asp-action="Index" title="Reservations"><span class="nav-icon">📅</span><span class="nav-label">Reservations</span></a> }
                    @if (canAssets) { <a class="nav-link" asp-controller="Assets" asp-action="Index" title="Assets"><span class="nav-icon">📦</span><span class="nav-label">Assets</span></a><a class="nav-link" asp-controller="Checkouts" asp-action="Index" title="Checkouts"><span class="nav-icon">📋</span><span class="nav-label">Checkouts</span></a> }
                    @if (canKeys) { <a class="nav-link" asp-controller="Keys" asp-action="Index" title="Keys"><span class="nav-icon">🔑</span><span class="nav-label">Keys</span></a><a class="nav-link" asp-controller="KeyAssignments" asp-action="Index" title="Key Assignments"><span class="nav-icon">🗝️</span><span class="nav-label">Key Assignments</span></a><a class="nav-link" asp-controller="AccessAreas" asp-action="Index" title="Access Areas"><span class="nav-icon">🚪</span><span class="nav-label">Access Areas</span></a> }
                    @if (canWorship) { <a class="nav-link" asp-controller="Worship" asp-action="Index" title="Worship Planning"><span class="nav-icon">🎵</span><span class="nav-label">Worship</span></a> }
                </div>
            </div>
        }

        @if (canSchool)
        {
            <div class="nav-section nav-group" data-nav-group="school">
                <button type="button" class="nav-section-title nav-section-toggle" onclick="toggleNavGroup('school')"><span>School</span><span class="nav-chevron">▾</span></button>
                <div class="nav-links">
                    <a class="nav-link" asp-controller="Students" asp-action="Index" title="Students"><span class="nav-icon">👨‍🎓</span><span class="nav-label">Students</span></a>
                    <a class="nav-link" asp-controller="FacultyStaff" asp-action="Index" title="Faculty / Staff"><span class="nav-icon">👩‍🏫</span><span class="nav-label">Faculty / Staff</span></a>
                </div>
            </div>
        }

        @if (canITAssets || canITSupport || canITRequester || canPasswordVault)
        {
            <div class="nav-section nav-group" data-nav-group="it">
                <button type="button" class="nav-section-title nav-section-toggle" onclick="toggleNavGroup('it')"><span>IT Operations</span><span class="nav-chevron">▾</span></button>
                <div class="nav-links">
                    @if (canITAssets) { <a class="nav-link" asp-controller="ITAssets" asp-action="Index" title="IT Assets"><span class="nav-icon">💻</span><span class="nav-label">IT Assets</span></a> }
                    @if (canPasswordVault) { <a class="nav-link" asp-controller="PasswordVault" asp-action="Index" title="Password Vault"><span class="nav-icon">🔐</span><span class="nav-label">Password Vault</span></a> }
                    @if (canITSupport)
                    {
                        <a class="nav-link" asp-controller="ITSupport" asp-action="Index" title="IT Support"><span class="nav-icon">🎫</span><span class="nav-label">IT Support</span></a>
                        <a class="nav-link" asp-controller="ITSupport" asp-action="TechnicianDashboard" title="Technician Dashboard"><span class="nav-icon">🧰</span><span class="nav-label">IT Dashboard</span></a>
                    }
                    @if (canITRequester && !canITSupport)
                    {
                        <a class="nav-link" asp-controller="ITSupport" asp-action="RequesterCreate" title="Submit IT Ticket"><span class="nav-icon">🆘</span><span class="nav-label">Submit IT Ticket</span></a>
                        <a class="nav-link" asp-controller="ITSupport" asp-action="MyTickets" title="My IT Tickets"><span class="nav-icon">🎫</span><span class="nav-label">My IT Tickets</span></a>
                    }
                </div>
            </div>
        }

        @if (canPeople || canAudit || canUsers)
        {
            <div class="nav-section nav-group" data-nav-group="administration">
                <button type="button" class="nav-section-title nav-section-toggle" onclick="toggleNavGroup('administration')"><span>Administration</span><span class="nav-chevron">▾</span></button>
                <div class="nav-links">
                    @if (canPeople) { <a class="nav-link" asp-controller="People" asp-action="Index" title="People"><span class="nav-icon">👥</span><span class="nav-label">People</span></a> }
                    @if (canAudit) { <a class="nav-link" asp-controller="Audit" asp-action="Index" title="Audit Log"><span class="nav-icon">📝</span><span class="nav-label">Audit Log</span></a> }
                    @if (canUsers)
                    {
                        <a class="nav-link" asp-controller="AdminUsers" asp-action="Index" title="Users"><span class="nav-icon">👤</span><span class="nav-label">Users</span></a>
                        <a class="nav-link" asp-controller="SetupWizard" asp-action="Index" title="Setup Wizard"><span class="nav-icon">🧭</span><span class="nav-label">Setup Wizard</span></a>
                        <a class="nav-link" asp-controller="License" asp-action="Index" title="Product License"><span class="nav-icon">🔑</span><span class="nav-label">Product License</span></a>
                        <a class="nav-link" asp-controller="Administration" asp-action="Index" title="System Settings"><span class="nav-icon">⚙️</span><span class="nav-label">System Settings</span></a>
                        <a class="nav-link" asp-controller="DashboardBuilder" asp-action="Index" title="Dashboard Builder"><span class="nav-icon">🧩</span><span class="nav-label">Dashboard Builder</span></a>
                        <a class="nav-link" asp-controller="SystemInfo" asp-action="Index" title="System Information"><span class="nav-icon">🖥️</span><span class="nav-label">System Info</span></a>
                    }
                </div>
            </div>
        }
    </aside>
}
<div class="main-shell">
<header class="topbar">
@if (User.Identity?.IsAuthenticated == true){<button type="button" class="mobile-menu-button" onclick="openSidebar()">☰ Menu</button>}
<div class="topbar-title"><strong>@portalBranding.PortalName</strong><span>@portalBranding.PortalSubtitle</span></div>
@if (User.Identity?.IsAuthenticated == true)
{

<button id="installAppTopButton" type="button" class="app-install-button" onclick="installCwcPortalApp()">⬇️ Install App</button>
<span id="appInstalledBadge" class="app-installed-badge">✓ App Installed</span>

<form class="topbar-global-search" asp-controller="Search" asp-action="Index" method="get">
    <input type="search" name="query" placeholder="Search..." value="@Context.Request.Query["query"]" />
</form>

@await Component.InvokeAsync("NotificationBell")
<div class="profile-menu">
<button type="button" class="profile-menu-button" onclick="toggleProfileMenu()">
@await Component.InvokeAsync("UserAvatar")
<span>@User.Identity.Name</span><span>▾</span></button>
<div id="profileDropdown" class="profile-dropdown">
<div class="profile-dropdown-header"><strong>@User.Identity.Name</strong><span>@portalBranding.PortalName</span></div>
<a asp-controller="Profile" asp-action="Index">Profile</a>
<a asp-controller="Profile" asp-action="ChangePassword">Change Password</a>
<button type="button" class="theme-toggle-button" onclick="toggleDarkMode()">Toggle Dark Mode</button>
<a asp-controller="App" asp-action="Index">Install / Download App</a>
<a asp-controller="UserGuide" asp-action="Index">User Guide</a>
<button id="installAppMenuButton" type="button" class="theme-toggle-button" onclick="installCwcPortalApp()" style="display:none">Install Portal App</button>

<form asp-controller="Account" asp-action="Logout" method="post">@Html.AntiForgeryToken()<button type="submit">Logout</button></form>
</div></div>}
</header>
<main class="content-area">@RenderBody()</main>
<footer class="footer"><strong>@portalBranding.PortalName</strong> v@(PortalVersion.Version) • @PortalVersion.ReleaseName • Build @PortalVersion.BuildDate<br /><span>Powered by Sunday Ready IT • © 2026 Sunday Ready IT • Licensed to @portalBranding.OrganizationName</span></footer>
</div></div>
<script>

function toggleNotificationMenu(){var m=document.getElementById('notificationDropdown');if(m)m.classList.toggle('open');}
document.addEventListener('click',function(e){var m=document.getElementById('notificationDropdown');var p=document.querySelector('.notification-menu');if(m&&p&&!p.contains(e.target)){m.classList.remove('open');}});

(function initializeSidebarState(){
    try {
        var isCollapsed = localStorage.getItem('cwc.sidebar.collapsed') === 'true';
        if (isCollapsed && window.innerWidth > 800) {
            document.body.classList.add('sidebar-collapsed');
        }
    } catch (e) {}
})();

function toggleSidebarCollapse(){
    document.body.classList.toggle('sidebar-collapsed');
    try {
        localStorage.setItem('cwc.sidebar.collapsed', document.body.classList.contains('sidebar-collapsed') ? 'true' : 'false');
    } catch (e) {}
}

function toggleNavGroup(key){
    var group=document.querySelector('[data-nav-group="'+key+'"]');
    if(!group)return;
    group.classList.toggle('group-collapsed');
    try{localStorage.setItem('cwc.nav.group.'+key,group.classList.contains('group-collapsed')?'collapsed':'expanded');}catch(e){}
}
(function initializeNavGroups(){
    document.querySelectorAll('[data-nav-group]').forEach(function(group){
        var key=group.getAttribute('data-nav-group');
        try{if(localStorage.getItem('cwc.nav.group.'+key)==='collapsed')group.classList.add('group-collapsed');}catch(e){}
    });
})();

function openSidebar(){var s=document.getElementById('sidebar');var b=document.getElementById('sidebarBackdrop');if(s)s.classList.add('open');if(b)b.classList.add('open');}
function closeSidebar(){var s=document.getElementById('sidebar');var b=document.getElementById('sidebarBackdrop');if(s)s.classList.remove('open');if(b)b.classList.remove('open');}
function toggleProfileMenu(){var m=document.getElementById('profileDropdown');if(m)m.classList.toggle('open');}
document.addEventListener('click',function(e){var m=document.getElementById('profileDropdown');var p=document.querySelector('.profile-menu');if(m&&p&&!p.contains(e.target)){m.classList.remove('open');}});

(function addBulkKeyAssignmentButton(){var path=window.location.pathname.toLowerCase();if(!(path.endsWith('/keyassignments')||path.endsWith('/keyassignments/index')))return;var appBase='@Url.Content("~/")';if(appBase.endsWith('/'))appBase=appBase.slice(0,-1);if(document.querySelector('.bulk-key-injected'))return;var bulkLink=document.createElement('a');bulkLink.className='btn primary bulk-key-injected';bulkLink.href=appBase+'/KeyAssignments/BulkCreate';bulkLink.textContent='Assign Multiple Keys';var pageHeader=document.querySelector('.page-header');if(pageHeader){var existingButton=pageHeader.querySelector('a.btn, a.btn-primary, button.btn, button.btn-primary');if(existingButton&&existingButton.parentElement){existingButton.parentElement.appendChild(bulkLink);return;}pageHeader.appendChild(bulkLink);}})();

(function addDeleteButtons(){var path=window.location.pathname.toLowerCase();var appBase='@Url.Content("~/")';if(appBase.endsWith('/'))appBase=appBase.slice(0,-1);var config=null;if(path.endsWith('/adminusers')||path.endsWith('/adminusers/index')){config={editPath:appBase+'/AdminUsers/Edit',deletePath:appBase+'/AdminDelete/DeleteUser/',label:'Delete User',message:'Permanently delete this user? Use this only for test or accidental users.'};}else if(path.endsWith('/people')||path.endsWith('/people/index')){config={editPath:appBase+'/People/Edit',deletePath:appBase+'/AdminDelete/DeletePerson/',label:'Delete',message:'Permanently delete this person? If they have history, use inactive instead.'};}else if(path.endsWith('/students')||path.endsWith('/students/index')){config={editPath:appBase+'/Students/Edit',deletePath:appBase+'/AdminDelete/DeleteStudent/',label:'Delete',message:'Permanently delete this student? Use this only for test or accidental records.'};}else if(path.endsWith('/facultystaff')||path.endsWith('/facultystaff/index')){config={editPath:appBase+'/FacultyStaff/Edit',deletePath:appBase+'/AdminDelete/DeleteFacultyStaff/',label:'Delete',message:'Permanently delete this faculty/staff record? Use this only for test or accidental records.'};}if(!config)return;var token=document.querySelector('#globalAntiForgeryForm input[name="__RequestVerificationToken"]');var tokenValue=token?token.value:'';var editPathNoBase=config.editPath.replace(appBase,'');var links=Array.from(document.querySelectorAll('a[href*="'+config.editPath+'"], a[href*="'+editPathNoBase+'"]'));links.forEach(function(link){var href=link.getAttribute('href')||'';var id=extractId(href);if(!id)return;var parent=link.parentElement;if(!parent||parent.querySelector('.delete-injected')||parent.querySelector('form[action*="Delete"], a[href*="Delete"], button.danger'))return;var form=document.createElement('form');form.method='post';form.action=config.deletePath+id;form.className='inline-form delete-injected';form.onsubmit=function(){return confirm(config.message);};var hidden=document.createElement('input');hidden.type='hidden';hidden.name='__RequestVerificationToken';hidden.value=tokenValue;form.appendChild(hidden);var button=document.createElement('button');button.type='submit';button.className='btn small danger';button.textContent=config.label;form.appendChild(button);parent.appendChild(form);});function extractId(href){var m=href.match(/\/Edit\/(\d+)/i);if(m&&m[1])return m[1];var q=href.match(/[?&]id=(\d+)/i);if(q&&q[1])return q[1];return null;}})();


let cwcPortalInstallPrompt = null;

function isCwcPortalStandalone(){
    return window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
}

function setCwcInstallButtonsVisible(visible){
    ['installAppTopButton','installAppMenuButton','installAppPageButton'].forEach(function(id){
        var btn = document.getElementById(id);
        if(btn) btn.style.display = visible ? (id === 'installAppTopButton' ? 'inline-flex' : 'block') : 'none';
    });
}

function setCwcInstallStatus(message){
    ['installAppStatus','installAppPageStatus'].forEach(function(id){
        var el = document.getElementById(id);
        if(el) el.textContent = message || '';
    });
}

function updateCwcInstallUi(){
    var installed = isCwcPortalStandalone();
    var badge = document.getElementById('appInstalledBadge');
    if(badge) badge.style.display = installed ? 'inline-flex' : 'none';

    if(installed){
        setCwcInstallButtonsVisible(false);
        setCwcInstallStatus('The CWC Operations Portal is already running as an installed app on this device.');
        return;
    }

    if(cwcPortalInstallPrompt){
        setCwcInstallButtonsVisible(true);
        setCwcInstallStatus('This device supports one-click installation. Click Install Portal App to continue.');
    } else {
        setCwcInstallButtonsVisible(false);
        setCwcInstallStatus('Use your browser menu and choose Install app, Add to taskbar, or Add to Home screen.');
    }
}

window.addEventListener('beforeinstallprompt', function(e) {
    e.preventDefault();
    cwcPortalInstallPrompt = e;
    updateCwcInstallUi();
});

window.addEventListener('appinstalled', function(){
    cwcPortalInstallPrompt = null;
    updateCwcInstallUi();
});

async function installCwcPortalApp(){
    if(!cwcPortalInstallPrompt){
        updateCwcInstallUi();
        return;
    }
    cwcPortalInstallPrompt.prompt();
    await cwcPortalInstallPrompt.userChoice;
    cwcPortalInstallPrompt = null;
    updateCwcInstallUi();
}

if ('serviceWorker' in navigator) {
    window.addEventListener('load', function(){
        navigator.serviceWorker.register('@Url.Content("~/service-worker.js")', { scope: '@Url.Content("~/")' }).then(function(){
            updateCwcInstallUi();
        }).catch(function(){
            setCwcInstallStatus('App install support is not available because the service worker could not register.');
        });
    });
} else {
    window.addEventListener('load', updateCwcInstallUi);
}
</script>

<partial name="_ToastNotifications" />

@RenderSection("Scripts", required: false)
</body>
</html>
