@model ChurchAssetTracker.Data.GlobalSearchViewModel
@{
    ViewData["Title"] = "Search";
}

<div class="page-header">
    <div>
        <h2>Global Search</h2>
        <p>Search across the CWC Operations Portal.</p>
    </div>
</div>

<form asp-controller="Search" asp-action="Index" method="get" class="global-search-page-form">
    <input type="search"
           name="query"
           value="@Model.Query"
           placeholder="Search people, tickets, assets, students, reservations..."
           autofocus />
    <button class="btn primary" type="submit">Search</button>
</form>

@if (!Model.HasSearched)
{
    <div class="panel">
        <h3>Start searching</h3>
        <p>Enter a name, ticket number, asset tag, room, reservation, key, or other keyword.</p>
    </div>
}
else if (!Model.HasResults)
{
    <div class="panel">
        <h3>No results found</h3>
        <p>No accessible records matched <strong>@Model.Query</strong>.</p>
    </div>
}
else
{
    <div class="search-results">
        @foreach (var group in Model.Groups)
        {
            <section class="search-group">
                <div class="search-group-header">
                    <h3><span>@group.Icon</span> @group.GroupName</h3>
                    <span>@group.Results.Count result@(group.Results.Count == 1 ? "" : "s")</span>
                </div>

                <div class="search-result-list">
                    @foreach (var item in group.Results)
                    {
                        <a class="search-result-item" href="@Url.Content("~" + item.Url)">
                            <div>
                                <strong>@item.Title</strong>

                                @if (!string.IsNullOrWhiteSpace(item.Subtitle))
                                {
                                    <span>@item.Subtitle</span>
                                }

                                @if (!string.IsNullOrWhiteSpace(item.Detail))
                                {
                                    <small>@item.Detail</small>
                                }
                            </div>

                            <em>@item.Badge</em>
                        </a>
                    }
                </div>
            </section>
        }
    </div>
}

<style>
.global-search-page-form {
    display: flex;
    gap: 10px;
    margin-bottom: 22px;
}

.global-search-page-form input {
    flex: 1;
    border: 1px solid #cbd5e1;
    border-radius: 14px;
    padding: 13px 14px;
    font-size: 1rem;
    background: #fff;
}

.search-results {
    display: grid;
    gap: 18px;
}

.search-group {
    background: #fff;
    border: 1px solid #dbe3ea;
    border-radius: 18px;
    padding: 18px;
    box-shadow: 0 10px 28px rgba(15,23,42,.06);
}

.search-group-header {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    align-items: center;
    margin-bottom: 12px;
}

.search-group-header h3 {
    margin: 0;
}

.search-group-header > span {
    color: #64748b;
    font-size: .9rem;
}

.search-result-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.search-result-item {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    text-decoration: none;
    color: #0f172a;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 13px 14px;
    background: #fff;
}

.search-result-item:hover {
    background: #f8fafc;
    border-color: #cbd5e1;
}

.search-result-item strong,
.search-result-item span,
.search-result-item small {
    display: block;
}

.search-result-item span {
    color: #475569;
    margin-top: 3px;
}

.search-result-item small {
    color: #64748b;
    margin-top: 3px;
}

.search-result-item em {
    align-self: flex-start;
    border-radius: 999px;
    padding: 5px 9px;
    background: #eef2ff;
    color: #3730a3;
    font-style: normal;
    font-weight: 800;
    font-size: .78rem;
    white-space: nowrap;
}

@@media (max-width: 700px) {
    .global-search-page-form {
        display: grid;
    }

    .search-result-item {
        display: grid;
    }
}
</style>