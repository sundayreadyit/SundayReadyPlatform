<style>
.faculty-documents-card{margin-top:22px}
.document-upload-form{background:#f8fafc;border:1px solid #dbe3ea;border-radius:18px;padding:16px;margin-top:14px}
.document-upload-grid{display:grid;grid-template-columns:minmax(180px,.6fr) minmax(240px,1fr) minmax(240px,1fr);gap:14px}
.faculty-documents-list{display:flex;flex-direction:column;gap:12px;margin-top:18px}
.document-row{display:grid;grid-template-columns:44px 1fr auto;gap:14px;align-items:center;background:#fff;border:1px solid #dbe3ea;border-radius:16px;padding:14px}
.document-icon{width:44px;height:44px;border-radius:14px;background:#eef2ff;display:flex;align-items:center;justify-content:center;font-size:1.35rem}
.document-info strong,.document-info span,.document-info small{display:block}
.document-info span{color:#64748b;margin-top:3px}
.document-info small{color:#64748b;margin-top:4px}
.document-actions{display:flex;gap:8px;flex-wrap:wrap}
.document-actions form{margin:0}
.document-empty{background:#fff;border:1px dashed #cbd5e1;border-radius:16px;padding:18px;color:#64748b}
.document-empty strong,.document-empty span{display:block}
.document-empty strong{color:#0f172a}
html.dark-mode .document-upload-form,html.dark-mode .document-row,html.dark-mode .document-empty{background:#020617!important;border-color:#334155!important;color:#e5e7eb!important}
html.dark-mode .document-info span,html.dark-mode .document-info small,html.dark-mode .document-empty{color:#94a3b8!important}
html.dark-mode .document-empty strong{color:#f8fafc!important}
html.dark-mode .document-icon{background:#1e3a8a!important}
@@media(max-width:900px){.document-upload-grid,.document-row{grid-template-columns:1fr}.document-actions{justify-content:flex-start}}
</style>