<style>
.school-form-hero{background:linear-gradient(135deg,#1e3a8a,#0f172a);color:#fff;border-radius:24px;padding:28px;margin-bottom:22px;box-shadow:0 18px 40px rgba(15,23,42,.18)}
.school-form-hero h2{margin:8px 0;color:#fff!important;font-size:2rem}
.school-form-hero p{margin:0;color:#dbeafe!important}
.school-form-shell{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(320px,.6fr);gap:22px;align-items:start}
.school-form-card,.school-side-box{background:#fff;border:1px solid #dbe3ea;border-radius:22px;padding:22px;box-shadow:0 10px 28px rgba(15,23,42,.06)}
.school-form-card h3,.school-side-box h3{margin:0 0 10px;font-size:1.2rem}
.school-form-card>p{margin-top:0;color:#64748b}
.school-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.school-grid.two{grid-template-columns:repeat(2,minmax(0,1fr))}
.school-grid.full{grid-template-columns:1fr}
.school-field{display:flex;flex-direction:column;gap:6px}
.school-field label{font-weight:800;color:#0f172a}
.school-field small{color:#64748b}
.school-field input,.school-field select,.school-field textarea{width:100%;box-sizing:border-box;border:1px solid #cbd5e1;border-radius:14px;padding:12px 13px;background:#fff;color:#0f172a;font-size:.98rem}
.school-field textarea{min-height:115px;resize:vertical}
.school-field input:focus,.school-field textarea:focus,.school-field select:focus{outline:none;border-color:#2563eb;box-shadow:0 0 0 3px rgba(37,99,235,.14)}
.school-side-panel{display:grid;gap:16px}
.school-side-box ul{margin:0;padding-left:18px;color:#475569}
.school-side-box li{margin-bottom:8px}
.school-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px;padding-top:18px;border-top:1px solid #e2e8f0}
.school-validation{background:#fee2e2;color:#991b1b;border:1px solid #fecaca;border-radius:16px;padding:14px;margin-bottom:18px}
.checkbox-row{display:inline-flex!important;flex-direction:row!important;align-items:center;gap:8px;font-weight:800}
.checkbox-row input{width:auto!important}
.photo-upload-grid{display:grid;grid-template-columns:180px 1fr;gap:18px;align-items:start}
.record-photo-card{background:#f8fafc;border:1px solid #dbe3ea;border-radius:20px;padding:16px;text-align:center}
.record-photo{width:132px;height:132px;border-radius:999px;object-fit:cover;border:4px solid #fff;box-shadow:0 10px 24px rgba(15,23,42,.14);background:#e2e8f0}
.record-photo.placeholder{display:inline-flex;align-items:center;justify-content:center;font-size:2.4rem;font-weight:900;color:#174c2f}
.photo-help{color:#64748b;margin-top:8px;font-size:.9rem}
html.dark-mode .school-form-card,html.dark-mode .school-side-box{background:#111827!important;border-color:#334155!important;color:#e5e7eb!important;box-shadow:0 12px 28px rgba(0,0,0,.32)!important}
html.dark-mode .school-form-card>p,html.dark-mode .school-side-box ul,html.dark-mode .school-field small,html.dark-mode .photo-help{color:#94a3b8!important}
html.dark-mode .school-field label{color:#f8fafc!important}
html.dark-mode .school-field input,html.dark-mode .school-field textarea,html.dark-mode .school-field select{background:#020617!important;border-color:#475569!important;color:#e5e7eb!important}
html.dark-mode .school-actions{border-top-color:#334155!important}
html.dark-mode .record-photo-card{background:#020617!important;border-color:#334155!important}
@@media(max-width:1000px){.school-form-shell{grid-template-columns:1fr}.school-grid,.school-grid.two{grid-template-columns:1fr}}
@@media(max-width:700px){.photo-upload-grid{grid-template-columns:1fr}.record-photo-card{text-align:left}.record-photo{width:96px;height:96px}}
</style>