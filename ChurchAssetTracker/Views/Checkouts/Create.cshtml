@model ChurchAssetTracker.Models.CheckoutCreateViewModel
@{
    ViewData["Title"] = "Check Out Asset";
    var returnUrl = Url.Action("Create", "Checkouts") ?? "/Checkouts/Create";
}

<div class="page-header">
    <div>
        <h1>Check Out Asset</h1>
        <p>Select the church item being borrowed and who is responsible for returning it.</p>
    </div>
    <a class="btn-secondary" asp-controller="Checkouts" asp-action="Index">Back to Checkouts</a>
</div>

<div class="form-card checkout-form-card">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-grid">
            <label>
                <span>Asset</span>
                <select asp-for="AssetId">
                    <option value="">-- Select asset --</option>
                    @foreach (var asset in Model.AvailableAssets)
                    {
                        <option value="@asset.Id">@asset.Name</option>
                    }
                </select>
                <span asp-validation-for="AssetId" class="field-validation"></span>
            </label>

            <div class="form-field borrower-field">
                <div class="field-label-row">
                    <label asp-for="PersonId">Borrower</label>
                    <a class="btn-secondary small new-person-button"
                       asp-controller="People"
                       asp-action="Create"
                       asp-route-returnUrl="@returnUrl">+ New Person</a>
                </div>
                <select asp-for="PersonId">
                    <option value="">-- Select person --</option>
                    @foreach (var person in Model.ActivePeople)
                    {
                        <option value="@person.Id">@person.Name</option>
                    }
                </select>
                <span asp-validation-for="PersonId" class="field-validation"></span>
                <small>If the borrower is missing, add them as a new person and return to this checkout form.</small>
            </div>

            <label>
                <span>Quantity Borrowed</span>
                <input asp-for="QuantityOut" type="number" min="1" />
                <span asp-validation-for="QuantityOut" class="field-validation"></span>
            </label>

            <label>
                <span>Expected Return Date</span>
                <input asp-for="ExpectedReturnDate" type="date" />
                <span asp-validation-for="ExpectedReturnDate" class="field-validation"></span>
            </label>

            <label>
                <span>Condition Out</span>
                <input asp-for="ConditionOut" placeholder="Good, fair, damaged, missing cable, etc." />
                <span asp-validation-for="ConditionOut" class="field-validation"></span>
            </label>

            <label class="full-width">
                <span>Checkout Notes</span>
                <textarea asp-for="CheckoutNotes" rows="4" placeholder="Optional notes about why it is being borrowed or any special instructions."></textarea>
                <span asp-validation-for="CheckoutNotes" class="field-validation"></span>
            </label>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">Save Checkout</button>
            <a class="btn-secondary" asp-controller="Checkouts" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

<style>
.checkout-form-card .field-label-row{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:6px}
.checkout-form-card .field-label-row label{margin:0;font-weight:800}
.checkout-form-card .new-person-button{white-space:nowrap;padding:.45rem .7rem;font-size:.85rem;text-decoration:none}
.checkout-form-card small{display:block;margin-top:6px;color:#64748b}
html.dark-mode .checkout-form-card small{color:#94a3b8!important}
@@media(max-width:700px){.checkout-form-card .field-label-row{align-items:flex-start;flex-direction:column}.checkout-form-card .new-person-button{width:100%;text-align:center}}
</style>
