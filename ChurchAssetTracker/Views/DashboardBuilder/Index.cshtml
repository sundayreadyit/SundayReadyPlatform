@model ChurchAssetTracker.Models.DashboardBuilderViewModel
@{
    ViewData["Title"] = "Dashboard Builder";
    var enabled = Model.EnabledWidgetKeys.ToHashSet(StringComparer.OrdinalIgnoreCase);
    var ordered = Model.EnabledWidgetKeys.Concat(Model.AvailableWidgets.Select(x => x.Key).Where(x => !enabled.Contains(x))).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
    var lookup = Model.AvailableWidgets.ToDictionary(x => x.Key, StringComparer.OrdinalIgnoreCase);
}
<div class="builder-page">
    <div class="builder-hero"><div><span>Administration</span><h1>Dashboard Builder</h1><p>Choose and arrange the widgets shown for each user profile.</p></div></div>
    @if (TempData["DashboardBuilderMessage"] is string message){<div class="builder-message">✓ @message</div>}
    <div class="profile-picker">
        @foreach(var p in new[]{"Default","Church","School","IT","Admin"}){<a asp-action="Index" asp-route-profile="@p" class="@(Model.Profile.Equals(p,StringComparison.OrdinalIgnoreCase)?"active":"")">@p</a>}
    </div>
    <form asp-action="Save" method="post" id="dashboardBuilderForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="profile" value="@Model.Profile" />
        <input type="hidden" name="orderedWidgets" id="orderedWidgets" />
        <div class="builder-note"><strong>@Model.Profile Dashboard</strong><span>Drag cards to reorder. Toggle cards on/off. Role permissions still control whether a user can see data from a module.</span></div>
        <div id="widgetList" class="widget-list">
        @foreach(var key in ordered)
        {
            var w=lookup[key];
            <div class="widget-builder-card" draggable="true" data-key="@w.Key">
                <div class="drag-handle">☰</div><div class="widget-copy"><strong>@w.DisplayName</strong><span>@w.Description</span></div>
                <label class="switch"><input type="checkbox" @(enabled.Contains(w.Key)?"checked":"") /><span></span></label>
            </div>
        }
        </div>
        <div class="builder-actions"><button type="submit">Save Dashboard</button></div>
    </form>
</div>
<style>
.builder-page{max-width:980px;margin:0 auto}.builder-hero{background:linear-gradient(135deg,#0f766e,#115e59);color:#fff;border-radius:20px;padding:28px;margin-bottom:18px}.builder-hero span{text-transform:uppercase;letter-spacing:.12em;font-size:.76rem;font-weight:800;color:#99f6e4}.builder-hero h1{margin:4px 0 7px}.builder-hero p{margin:0;color:#ccfbf1}.builder-message{background:#f0fdf4;border:1px solid #86efac;color:#166534;border-radius:12px;padding:12px 14px;margin-bottom:14px}.profile-picker{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}.profile-picker a{text-decoration:none;border:1px solid #cbd5e1;background:#fff;color:#334155;border-radius:999px;padding:9px 13px;font-weight:800}.profile-picker a.active{background:#174c2f;color:#fff;border-color:#174c2f}.builder-note{display:flex;flex-direction:column;background:#fff;border:1px solid #dbe3ea;border-radius:14px;padding:15px;margin-bottom:12px}.builder-note span{color:#64748b;margin-top:4px}.widget-list{display:grid;gap:10px}.widget-builder-card{display:grid;grid-template-columns:auto 1fr auto;gap:14px;align-items:center;background:#fff;border:1px solid #dbe3ea;border-radius:14px;padding:14px;box-shadow:0 7px 18px rgba(15,23,42,.04);cursor:grab}.widget-builder-card.dragging{opacity:.45}.drag-handle{font-size:1.2rem;color:#64748b}.widget-copy strong,.widget-copy span{display:block}.widget-copy span{color:#64748b;font-size:.9rem;margin-top:3px}.switch input{width:22px;height:22px}.builder-actions{display:flex;justify-content:flex-end;margin-top:16px}.builder-actions button{border:0;background:#174c2f;color:#fff;border-radius:10px;padding:11px 15px;font-weight:800}html.dark-mode .builder-note,html.dark-mode .widget-builder-card,html.dark-mode .profile-picker a{background:#111827!important;color:#e5e7eb!important;border-color:#334155!important}html.dark-mode .profile-picker a.active{background:#15803d!important;color:#fff!important}html.dark-mode .widget-copy span,html.dark-mode .builder-note span,html.dark-mode .drag-handle{color:#94a3b8!important}
</style>
<script>
(function(){var list=document.getElementById('widgetList');var dragging=null;list.querySelectorAll('.widget-builder-card').forEach(function(card){card.addEventListener('dragstart',function(){dragging=card;card.classList.add('dragging');});card.addEventListener('dragend',function(){card.classList.remove('dragging');dragging=null;});});list.addEventListener('dragover',function(e){e.preventDefault();if(!dragging)return;var after=Array.from(list.querySelectorAll('.widget-builder-card:not(.dragging)')).find(function(el){var r=el.getBoundingClientRect();return e.clientY<r.top+r.height/2;});if(after)list.insertBefore(dragging,after);else list.appendChild(dragging);});document.getElementById('dashboardBuilderForm').addEventListener('submit',function(){var keys=Array.from(list.querySelectorAll('.widget-builder-card')).filter(function(c){return c.querySelector('input').checked;}).map(function(c){return c.dataset.key;});document.getElementById('orderedWidgets').value=keys.join(',');});})();
</script>
