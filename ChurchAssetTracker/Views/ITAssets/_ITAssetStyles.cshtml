<style>
.it-assets-page {
    max-width: 1600px;
    margin: 0 auto;
}

.it-page-header {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    align-items: flex-start;
    margin-bottom: 22px;
}

.it-page-header h1 {
    margin: 4px 0 8px;
    font-size: 2.05rem;
}

.it-page-header p {
    margin: 0;
    color: #64748b;
}

.eyebrow {
    display: inline-block;
    font-size: .78rem;
    font-weight: 900;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: #174c2f;
}

.it-card,
.it-table-card {
    background: #fff;
    border: 1px solid #dbe3ea;
    border-radius: 22px;
    padding: 22px;
    margin-bottom: 20px;
    box-shadow: 0 10px 28px rgba(15,23,42,.06);
}

.it-table-card {
    padding: 0;
    overflow: hidden;
}

.section-title {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
}

.section-icon {
    width: 48px;
    height: 48px;
    border-radius: 16px;
    background: #eef2ff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.35rem;
    flex: 0 0 auto;
}

.section-title h2 {
    margin: 0 0 4px;
    font-size: 1.25rem;
}

.section-title p {
    margin: 0;
    color: #64748b;
}

.it-form-grid,
.it-filter-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(180px, 1fr));
    gap: 16px;
    align-items: end;
}

.it-filter-grid {
    grid-template-columns: minmax(280px, 1fr) auto auto;
}

.it-field {
    display: flex;
    flex-direction: column;
    gap: 7px;
}

.it-field label {
    font-weight: 900;
    color: #0f172a;
}

.it-field input,
.it-field select,
.it-field textarea {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid #cbd5e1;
    border-radius: 14px;
    padding: 12px 13px;
    background: #fff;
    color: #0f172a;
    font: inherit;
}

.it-field textarea {
    resize: vertical;
}

.it-field span {
    color: #991b1b;
    font-size: .85rem;
}

.span-2 {
    grid-column: span 2;
}

.span-full {
    grid-column: 1 / -1;
}

.it-checkbox {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 900;
    color: #0f172a;
}

.it-filter-actions,
.it-row-actions,
.sticky-actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
}

.sticky-actions {
    position: sticky;
    bottom: 0;
    background: rgba(241,245,249,.9);
    backdrop-filter: blur(8px);
    border: 1px solid #dbe3ea;
    border-radius: 18px;
    padding: 14px;
    margin-top: 18px;
    z-index: 4;
}

.security-note {
    background: #fffbeb;
    border: 1px solid #fde68a;
    color: #92400e;
    border-radius: 16px;
    padding: 14px 16px;
    margin-bottom: 18px;
}

.it-table {
    width: 100%;
    border-collapse: collapse;
}

.it-table th,
.it-table td {
    padding: 15px 16px;
    border-bottom: 1px solid #e2e8f0;
    text-align: left;
    vertical-align: middle;
}

.it-table th {
    background: #f8fafc;
    font-weight: 900;
    color: #0f172a;
}

.it-table tbody tr:hover {
    background: #f8fafc;
}

.it-asset-name {
    display: flex;
    align-items: center;
    gap: 12px;
}

.it-asset-icon {
    width: 46px;
    height: 46px;
    border-radius: 14px;
    background: #eef2ff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    flex: 0 0 auto;
}

.it-asset-name strong,
.muted-block {
    display: block;
}

.it-asset-name span,
.muted-block {
    color: #64748b;
    margin-top: 3px;
    font-size: .9rem;
}

.status-pill {
    display: inline-flex;
    border-radius: 999px;
    padding: 5px 10px;
    font-size: .8rem;
    font-weight: 900;
    border: 1px solid transparent;
}

.status-pill.active {
    background: #dcfce7;
    color: #166534;
    border-color: #bbf7d0;
}

.status-pill.inactive {
    background: #f1f5f9;
    color: #475569;
    border-color: #cbd5e1;
}

.btn.small {
    padding: 7px 10px;
    font-size: .85rem;
}

html.dark-mode .it-card,
html.dark-mode .it-table-card {
    background: #111827 !important;
    border-color: #334155 !important;
    color: #e5e7eb !important;
    box-shadow: 0 12px 28px rgba(0,0,0,.32) !important;
}

html.dark-mode .it-page-header p,
html.dark-mode .section-title p,
html.dark-mode .it-asset-name span,
html.dark-mode .muted-block {
    color: #94a3b8 !important;
}

html.dark-mode .eyebrow {
    color: #86efac !important;
}

html.dark-mode .section-icon,
html.dark-mode .it-asset-icon {
    background: #1e3a8a !important;
}

html.dark-mode .it-field label,
html.dark-mode .it-checkbox,
html.dark-mode .it-table th {
    color: #f8fafc !important;
}

html.dark-mode .it-field input,
html.dark-mode .it-field select,
html.dark-mode .it-field textarea {
    background: #020617 !important;
    border-color: #475569 !important;
    color: #e5e7eb !important;
}

html.dark-mode .it-table th {
    background: #1f2937 !important;
    border-color: #334155 !important;
}

html.dark-mode .it-table td {
    border-color: #334155 !important;
}

html.dark-mode .it-table tbody tr:hover {
    background: #1f2937 !important;
}

html.dark-mode .security-note {
    background: #422006 !important;
    border-color: #92400e !important;
    color: #fde68a !important;
}

html.dark-mode .sticky-actions {
    background: rgba(2,6,23,.9) !important;
    border-color: #334155 !important;
}

@@media(max-width: 1000px) {
    .it-form-grid,
    .it-filter-grid {
        grid-template-columns: 1fr;
    }

    .span-2,
    .span-full {
        grid-column: auto;
    }

    .it-table-card {
        overflow-x: auto;
    }

    .it-table {
        min-width: 950px;
    }
}
</style>


<style>
.password-field-wrap {
    display: flex;
    gap: 8px;
    align-items: stretch;
}

.password-field-wrap input {
    flex: 1;
}

.password-toggle {
    border: 1px solid #cbd5e1;
    background: #f8fafc;
    color: #0f172a;
    border-radius: 12px;
    padding: 0 13px;
    font-weight: 900;
    cursor: pointer;
}

.password-display-wrap {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
}

.password-display {
    font-family: Consolas, Monaco, monospace;
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 12px;
    padding: 8px 10px;
    min-width: 220px;
}

html.dark-mode .password-toggle {
    background: #020617 !important;
    border-color: #475569 !important;
    color: #e5e7eb !important;
}

html.dark-mode .password-display {
    background: #020617 !important;
    border-color: #475569 !important;
    color: #e5e7eb !important;
}
</style>


<style>
.alert.success {
    background: #dcfce7;
    border: 1px solid #bbf7d0;
    color: #166534;
    border-radius: 14px;
    padding: 12px 14px;
    margin-bottom: 16px;
}

.alert.danger {
    background: #fee2e2;
    border: 1px solid #fecaca;
    color: #991b1b;
    border-radius: 14px;
    padding: 12px 14px;
    margin-bottom: 16px;
}

html.dark-mode .alert.success {
    background: #052e16 !important;
    border-color: #166534 !important;
    color: #bbf7d0 !important;
}

html.dark-mode .alert.danger {
    background: #450a0a !important;
    border-color: #991b1b !important;
    color: #fecaca !important;
}
</style>
